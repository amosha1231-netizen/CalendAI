# Used by `npm run cap:build:*` (vite --mode capacitor). The native app runs
# from capacitor://localhost, so API calls must go to the backend's full URL.
VITE_API_URL=https://calendai-backend-dfmi.onrender.com

# RevenueCat public SDK keys (Project settings → API keys in RevenueCat).
# Without a key the app hides in-app purchase on that platform.
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=
